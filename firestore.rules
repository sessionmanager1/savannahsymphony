rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['franklinesaitoti9@gmail.com', 'rafaelloso@icloud.com'];
    }

    match /reviews/{id} {
      // Anyone can read reviews and submit a new one
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','location','trip','rating','text','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() <= 1200
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;

      // Only the admin can reply (reply fields only) or delete
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply','replyAt']);
      allow delete: if isAdmin();
    }
  }
}
